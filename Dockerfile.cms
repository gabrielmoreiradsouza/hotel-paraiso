FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.34.1 --activate
WORKDIR /app

# Install dependencies
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/cms/package.json ./apps/cms/
COPY packages/ui/package.json ./packages/ui/
RUN pnpm install --frozen-lockfile --filter @hotel-paraiso/cms...

# Build
FROM base AS builder
COPY --from=deps /app/ ./
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
ENV PAYLOAD_SECRET=build-time-secret
ENV DATABASE_URL=postgres://hotel_paraiso:HpCms2026Prod!Secure@lp-mds_hp-postgres:5432/hotel_paraiso
RUN cd apps/cms && npx next build

# Production — full copy, no standalone (Payload needs all node_modules)
FROM node:22-alpine AS runner
RUN corepack enable && corepack prepare pnpm@10.34.1 --activate
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Copy everything needed
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/cms ./apps/cms
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml

# Create media directory
RUN mkdir -p /app/apps/cms/media

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
WORKDIR /app/apps/cms
CMD ["npx", "next", "start", "-p", "3000"]
