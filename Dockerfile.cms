FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.34.1 --activate
WORKDIR /app

# Install dependencies
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/cms/package.json ./apps/cms/
COPY packages/ui/package.json ./packages/ui/
RUN pnpm install --frozen-lockfile --filter @hotel-paraiso/cms...

# Build
FROM base AS builder
COPY --from=deps /app/ ./
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
# Payload needs these at build time but should NOT connect to DB
ENV PAYLOAD_SECRET=build-time-secret-not-used-in-runtime
# Use a dummy DB URL - Payload won't actually connect during build with SKIP_PUSH
ENV DATABASE_URL=postgresql://dummy:dummy@localhost:5432/dummy
ENV SKIP_ENV_VALIDATION=1
RUN pnpm --filter @hotel-paraiso/cms build

# Production
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 payload

# Copy standalone server
COPY --from=builder --chown=payload:nodejs /app/apps/cms/.next/standalone ./

# Copy public assets (may not exist)
COPY --from=builder --chown=payload:nodejs /app/apps/cms/public ./apps/cms/public 2>/dev/null || true

# Copy static files
COPY --from=builder --chown=payload:nodejs /app/apps/cms/.next/static ./apps/cms/.next/static

# Create media directory for uploads
RUN mkdir -p /app/apps/cms/media && chown payload:nodejs /app/apps/cms/media

USER payload
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
CMD ["node", "apps/cms/server.js"]
